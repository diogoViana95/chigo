# Prisma Postgres: use the direct connection string copied from Prisma Console.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Optional initial admin credentials. Defaults to admin/admin when omitted.
# Change the password at first login before using the backoffice.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="a-strong-temporary-password"
